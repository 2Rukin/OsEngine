<Window x:Class="OsEngine.Indicators.ThresholdTimeProfilesUi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="780" Height="650" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterScreen" Style="{DynamicResource WindowStyleCanResize}">
    <Grid Margin="10" Background="{DynamicResource ControlBackgroundNormalLight}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel>
            <CheckBox Name="CheckBoxEnabled" Margin="5"/>
            <CheckBox Name="CheckBoxBaseOutside" Margin="5"/>
            <CheckBox Name="CheckBoxReset" Margin="5"/>
        </WrapPanel>
        <TextBlock Name="TextBlockHelp" Grid.Row="1" TextWrapping="Wrap" Margin="5" Foreground="{DynamicResource ControlForegroundWhite}"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Name="StackPanelPeriods"/>
        </ScrollViewer>
        <TextBlock Name="TextBlockStatus" Grid.Row="3" TextWrapping="Wrap" Margin="5" Foreground="{DynamicResource ControlForegroundWhite}"/>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Name="ButtonAdd" HorizontalAlignment="Left" MinHeight="32" Margin="4" Padding="10,4"/>
            <Button Name="ButtonAccept" Grid.Column="1" MinHeight="32" Margin="4" Padding="10,4"/>
            <Button Name="ButtonCancel" Grid.Column="2" MinHeight="32" Margin="4" Padding="10,4" IsCancel="True"/>
        </Grid>
    </Grid>
</Window>
