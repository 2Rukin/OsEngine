<Window x:Class="OsEngine.OsData.OrderFlow.Calibration.CloudAnatomyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="1000" Height="650" MinWidth="600" MinHeight="360"
        Style="{DynamicResource WindowStyleCanResize}" WindowStartupLocation="CenterScreen">
    <Grid Margin="10" Background="{DynamicResource ControlBackgroundNormalLight}">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Name="TextBlockSummary" TextWrapping="Wrap" Foreground="{DynamicResource ControlForegroundWhite}" Margin="8"/>
        </ScrollViewer>
        <WrapPanel Grid.Row="1">
            <Button Name="ButtonTicks" Height="Auto" MinHeight="32" Padding="8,4" Margin="4"/>
            <Button Name="ButtonLevels" Height="Auto" MinHeight="32" Padding="8,4" Margin="4"/>
            <Button Name="ButtonPairs" Height="Auto" MinHeight="32" Padding="8,4" Margin="4"/>
            <Button Name="ButtonContext" Height="Auto" MinHeight="32" Padding="8,4" Margin="4"/>
            <Button Name="ButtonContextPairs" Height="Auto" MinHeight="32" Padding="8,4" Margin="4"/>
        </WrapPanel>
    </Grid>
</Window>
