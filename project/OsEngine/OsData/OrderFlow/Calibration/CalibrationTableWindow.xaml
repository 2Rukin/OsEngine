<Window x:Class="OsEngine.OsData.OrderFlow.Calibration.CalibrationTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1180" Height="700" MinWidth="600" MinHeight="400"
        Style="{DynamicResource WindowStyleCanResize}" WindowStartupLocation="CenterScreen">
    <Grid Margin="8" Background="{DynamicResource ControlBackgroundNormalLight}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Name="TextBlockContext" TextWrapping="Wrap" Foreground="{DynamicResource ControlForegroundWhite}" Margin="4"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="220">
            <WrapPanel>
                <TextBox Name="TextBoxSearch" Width="180" Margin="4"/>
                <TextBox Name="TextBoxTimeRange" Width="140" Margin="4"/>
                <ComboBox Name="ComboBoxDirection" Width="100" Margin="4"/>
                <ComboBox Name="ComboBoxNumeric" Width="160" Margin="4"/>
                <TextBox Name="TextBoxMinimum" Width="90" Margin="4"/>
                <TextBox Name="TextBoxMaximum" Width="90" Margin="4"/>
                <Button Name="ButtonApply" Height="Auto" MinHeight="30" Padding="8,4" Margin="4"/>
                <Button Name="ButtonReset" Height="Auto" MinHeight="30" Padding="8,4" Margin="4"/>
                <Button Name="ButtonSelect" Height="Auto" MinHeight="30" Padding="8,4" Margin="4"/>
            </WrapPanel>
        </ScrollViewer>
        <DataGrid Name="DataGridRows" Grid.Row="2" Style="{DynamicResource DataGridStyle}" IsReadOnly="True" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single"/>
        <WrapPanel Grid.Row="3">
            <Button Name="ButtonPrevious" Height="Auto" MinHeight="30" Padding="8,4" Margin="4"/>
            <Button Name="ButtonNext" Height="Auto" MinHeight="30" Padding="8,4" Margin="4"/>
            <TextBlock Name="TextBlockStatus" Margin="6" TextWrapping="Wrap" Foreground="{DynamicResource ControlForegroundWhite}"/>
        </WrapPanel>
    </Grid>
</Window>
