<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <AssemblyName>OsEngine.OrderFlowResearch.Tests</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reuse the existing friend-assembly boundary without changing files outside OrderFlow. -->
    <Compile Include="Checks.cs.fixture" />
    <ProjectReference Include="..\..\..\..\OsEngine.csproj" />
    <EmbeddedResource Include="..\..\..\..\App.xaml" LogicalName="Checks.App.xaml" />
    <Resource Include="..\..\..\..\Images\OsLogo.ico" Link="Images\OsLogo.ico" />
  </ItemGroup>
</Project>
