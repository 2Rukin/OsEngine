<UserControl x:Class="OsEngine.OsData.OrderFlow.Explorer.CloudExplorerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Name="TextBlockIdentity" Text="Новый режим выключен. Выберите настройки и нажмите «Рассчитать каталог». Источник, даты и ручной шаг цены — в верхней части окна." TextWrapping="Wrap" Margin="3"/>
        <TabControl Name="TabControlOptions" Grid.Row="1">
            <TabItem Header="Формирование — новый расчёт">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <CheckBox Name="CheckBoxLayer1" Content="Cloud 1" IsChecked="True" Margin="6"/>
                        <CheckBox Name="CheckBoxLayer2" Content="Cloud 2" IsChecked="True" Margin="6"/>
                        <CheckBox Name="CheckBoxScales" Content="Узкий / базовый / широкий" Margin="6"/>
                        <TextBlock Text="Профиль" VerticalAlignment="Center"/>
                        <ComboBox Name="ComboBoxProfile" Width="140" Margin="5"/>
                        <TextBlock Text="Кэш записей" VerticalAlignment="Center"/><TextBox Name="TextBoxBufferLimit" Text="250000" Width="75" Margin="4"/>
                        <TextBlock Text="Память MiB" VerticalAlignment="Center"/><TextBox Name="TextBoxMemoryLimit" Text="1024" Width="55" Margin="4"/>
                    </WrapPanel>
                    <DataGrid Name="DataGridFormation" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True">
                        <DataGrid.Columns><DataGridTextColumn Header="Параметр" Binding="{Binding Name}" IsReadOnly="True" Width="280"/><DataGridTextColumn Header="Значение" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="130"/><DataGridTextColumn Header="Пояснение" Binding="{Binding Help}" IsReadOnly="True" Width="*"/></DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Видимость — применить сразу">
                <DataGrid Name="DataGridView" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True">
                    <DataGrid.Columns><DataGridTextColumn Header="Фильтр выбранного профиля" Binding="{Binding Name}" IsReadOnly="True" Width="280"/><DataGridTextColumn Header="Значение" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="130"/><DataGridTextColumn Header="Пояснение" Binding="{Binding Help}" IsReadOnly="True" Width="*"/></DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Адаптация и активность">
                <DataGrid Name="DataGridAdaptation" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True">
                    <DataGrid.Columns><DataGridTextColumn Header="Параметр выбранного профиля" Binding="{Binding Name}" IsReadOnly="True" Width="280"/><DataGridTextColumn Header="Значение" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="130"/><DataGridTextColumn Header="Пояснение" Binding="{Binding Help}" IsReadOnly="True" Width="*"/></DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Эпизоды / VWAP / экстремумы">
                <DataGrid Name="DataGridModules" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True">
                    <DataGrid.Columns><DataGridTextColumn Header="Параметр" Binding="{Binding Name}" IsReadOnly="True" Width="280"/><DataGridTextColumn Header="Значение" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="130"/><DataGridTextColumn Header="Пояснение" Binding="{Binding Help}" IsReadOnly="True" Width="*"/></DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Исследование">
                <DataGrid Name="DataGridStudy" AutoGenerateColumns="False" CanUserAddRows="False" EnableRowVirtualization="True">
                    <DataGrid.Columns><DataGridTextColumn Header="Гипотеза" Binding="{Binding Name}" IsReadOnly="True" Width="280"/><DataGridTextColumn Header="Значение" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="130"/><DataGridTextColumn Header="Пояснение" Binding="{Binding Help}" IsReadOnly="True" Width="*"/></DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        <WrapPanel Grid.Row="2" Margin="2">
            <Button Name="ButtonCalculate" Content="Рассчитать каталог / исследование" Padding="8,4" Margin="2"/>
            <Button Name="ButtonReopen" Content="Открыть результат" Padding="8,4" Margin="2"/>
            <Button Name="ButtonCancel" Content="Отмена" Padding="8,4" Margin="2"/>
            <Button Name="ButtonFilter" Content="Применить видимость" Padding="8,4" Margin="2"/>
            <Button Name="ButtonFirst" Content="Первая страница" Padding="8,4" Margin="2"/>
            <Button Name="ButtonNext" Content="Следующие 250" Padding="8,4" Margin="2"/>
            <TextBox Name="TextBoxFind" Width="180" ToolTip="Точный ID или его часть" Margin="2"/>
            <Button Name="ButtonFind" Content="Найти ID" Padding="8,4" Margin="2"/>
            <Button Name="ButtonArtifacts" Content="Файлы" Padding="8,4" Margin="2"/>
        </WrapPanel>
        <TabControl Name="TabControlResult" Grid.Row="3">
            <TabItem Header="Каталог">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="90"/></Grid.RowDefinitions>
                    <DataGrid Name="DataGridCatalog" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionMode="Single"/>
                    <TextBox Name="TextBoxDetails" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>
            <TabItem Header="Сводка"><TextBox Name="TextBoxSummary" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem>
            <TabItem Header="Эпизоды"><DataGrid Name="DataGridEpisodes" IsReadOnly="True" AutoGenerateColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" CanUserAddRows="False"/></TabItem>
            <TabItem Header="Наблюдения"><DataGrid Name="DataGridObservations" IsReadOnly="True" AutoGenerateColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" CanUserAddRows="False"/></TabItem>
            <TabItem Header="Будущие исходы"><DataGrid Name="DataGridLabels" IsReadOnly="True" AutoGenerateColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" CanUserAddRows="False"/></TabItem>
            <TabItem Header="Триггеры"><DataGrid Name="DataGridTriggers" IsReadOnly="True" AutoGenerateColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" CanUserAddRows="False"/></TabItem>
            <TabItem Header="Экстремумы"><DataGrid Name="DataGridPivots" IsReadOnly="True" AutoGenerateColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" CanUserAddRows="False"/></TabItem>
            <TabItem Header="Причины / активные наблюдения"><DataGrid Name="DataGridDiagnostics" IsReadOnly="True" AutoGenerateColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" CanUserAddRows="False"/></TabItem>
            <TabItem Header="Сравнение групп"><TextBox Name="TextBoxComparison" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/></TabItem>
            <TabItem Name="TabItemChart" Header="График / реплей">
                <ContentControl Name="ContentControlChart">
                    <Grid Name="GridChartSurface">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <WrapPanel>
                            <ComboBox Name="ComboBoxTimeFrame" Width="85" Margin="2" ToolTip="Таймфрейм только отображения"/>
                            <ComboBox Name="ComboBoxPriceStyle" Width="80" Margin="2" ToolTip="Свечи / бары / High-Low"/>
                            <CheckBox Name="CheckBoxDraw" Content="Линия" VerticalAlignment="Center" Margin="3"/>
                            <Button Name="ButtonClearLines" Content="Очистить линии" Padding="5" Margin="2"/>
                            <Button Name="ButtonAnchor" Content="VWAP выбранного Cloud / эпизода" Padding="5" Margin="2"/>
                            <CheckBox Name="CheckBoxTriggerAnchor" Content="От первого trigger" VerticalAlignment="Center" Margin="3"/>
                            <CheckBox Name="CheckBoxBands" Content="Полосы σ" IsChecked="True" VerticalAlignment="Center" Margin="3"/>
                            <Button Name="ButtonSeparate" Content="Отдельное окно" Padding="5" Margin="2"/>
                            <Button Name="ButtonReplay" Content="Реплей" Padding="5" Margin="2"/>
                            <Button Name="ButtonPause" Content="Пауза" Padding="5" Margin="2"/>
                            <Button Name="ButtonStep" Content="Один тик" Padding="5" Margin="2"/>
                            <Button Name="ButtonHistory" Content="История" Padding="5" Margin="2"/>
                            <TextBlock Text="Тиков / кадр" VerticalAlignment="Center"/>
                            <TextBox Name="TextBoxSpeed" Width="55" Text="1" Margin="2"/>
                        </WrapPanel>
                        <ContentControl Name="ContentControlPlot" Grid.Row="1"/>
                    </Grid>
                </ContentControl>
            </TabItem>
        </TabControl>
        <TextBlock Name="TextBlockStatus" Grid.Row="4" Text="Только исследование. Без заявок, исполнения и PnL." TextWrapping="Wrap" Margin="3"/>
    </Grid>
</UserControl>
