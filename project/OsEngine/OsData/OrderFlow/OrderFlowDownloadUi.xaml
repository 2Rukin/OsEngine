<Window x:Class="OsEngine.OsData.OrderFlow.OrderFlowDownloadUi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QScalp archive" Width="1000" Height="650" MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterOwner" Style="{StaticResource WindowStyleCanResize}"
        Icon="/Images/OsLogo.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Name="TextBlockHelp" Grid.Row="0" Margin="4,0,4,10" TextWrapping="Wrap"
                   Foreground="{DynamicResource ControlForegroundWhite}"/>
        <WrapPanel Name="PanelPeriod" Grid.Row="1" Margin="0,0,0,6">
            <Label Name="LabelFrom" Content="From"/>
            <DatePicker Name="DateFrom" Width="145" Margin="4"/>
            <Label Name="LabelTo" Content="Through"/>
            <DatePicker Name="DateTo" Width="145" Margin="4"/>
            <Button Name="ButtonCatalog" Content="Load instruments" Margin="8,4" Padding="10,3"/>
            <Label Name="LabelInstrument" Content="Instrument"/>
            <ComboBox Name="ComboInstrument" Width="160" Margin="4" IsTextSearchEnabled="True"/>
        </WrapPanel>
        <Grid Name="GridFolder" Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Name="LabelFolder" Content="Download folder"/>
            <TextBox Name="TextBoxFolder" Grid.Column="1" Margin="4"/>
            <Button Name="ButtonFolder" Grid.Column="2" Content="Browse" Margin="4" Padding="10,3"/>
        </Grid>
        <WrapPanel Grid.Row="3" Margin="0,0,0,6">
            <Button Name="ButtonDownload" Content="Download period" Margin="4" Padding="10,3" IsEnabled="False"/>
            <Button Name="ButtonCancel" Content="Cancel" Margin="4" Padding="10,3" IsEnabled="False"/>
            <TextBlock Name="TextBlockAvailability" Margin="10,4" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource ControlForegroundWhite}"/>
        </WrapPanel>
        <DataGrid Name="GridDays" Grid.Row="4" IsReadOnly="True" AutoGenerateColumns="False"
                  CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                  EnableRowVirtualization="True" Margin="4">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColumnDate" Header="Date" Binding="{Binding DateText}" Width="110"/>
                <DataGridTextColumn x:Name="ColumnSize" Header="Bytes" Binding="{Binding SizeText}" Width="110"/>
                <DataGridTextColumn x:Name="ColumnStatus" Header="Status" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="5" Margin="4">
            <ProgressBar Name="Progress" Height="12" Minimum="0" Maximum="1"/>
            <TextBlock Name="TextBlockStatus" Margin="0,6" TextWrapping="Wrap"
                       Foreground="{DynamicResource ControlForegroundWhite}"/>
        </StackPanel>
        <Button Name="ButtonOpen" Grid.Row="6" Content="Open selected day" HorizontalAlignment="Right"
                Padding="14,5" Margin="4" IsEnabled="False"/>
    </Grid>
</Window>
