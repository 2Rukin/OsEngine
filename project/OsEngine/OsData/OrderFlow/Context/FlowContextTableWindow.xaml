<Window x:Class="OsEngine.OsData.OrderFlow.Context.FlowContextTableWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="1150" Height="650" MinWidth="600" MinHeight="350" Style="{DynamicResource WindowStyleCanResize}" WindowStartupLocation="CenterScreen">
 <Grid Margin="8" Background="{DynamicResource ControlBackgroundNormalLight}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBlock Name="TextBlockContext" TextWrapping="Wrap" Margin="4" Foreground="{DynamicResource ControlForegroundWhite}"/>
 <DataGrid Name="DataGridRows" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="True" CanUserSortColumns="True" SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True"/>
 <Button Name="ButtonSelect" Grid.Row="2" Content="Показать выбранное на графике" HorizontalAlignment="Right" Padding="12,6" Margin="4"/>
 </Grid>
</Window>
