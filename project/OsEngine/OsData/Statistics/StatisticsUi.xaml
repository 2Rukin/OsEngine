<Window x:Class="OsEngine.OsData.Statistics.StatisticsUi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="Statistics" Width="1180" Height="820" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterOwner" Style="{StaticResource WindowStyleCanResize}" Icon="/Images/OsLogo.ico">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ControlForegroundWhite}"/></Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Name="GridInputs">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
            <Grid Grid.ColumnSpan="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Label Name="LabelFolder"/>
                <TextBox Name="TextBoxFolder" Grid.Column="1" Margin="5,0" VerticalContentAlignment="Center"/>
                <Button Name="ButtonBrowse" Grid.Column="2" MinWidth="90" Margin="0,0,5,0"/>
                <Button Name="ButtonLoad" Grid.Column="3" MinWidth="130"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,8,8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Label Name="LabelFirst"/><ComboBox Name="ComboBoxFirst" Grid.Row="1" DisplayMemberPath="DisplayName"/>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,8,8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Label Name="LabelSecond"/><ComboBox Name="ComboBoxSecond" Grid.Row="1" DisplayMemberPath="DisplayName"/>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Label Name="LabelTimeFrame"/><ComboBox Name="ComboBoxTimeFrame" Grid.Row="1"/>
            </Grid>
            <Grid Grid.Row="2" Margin="0,0,8,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Name="LabelFrom"/><DatePicker Name="DatePickerFrom" Grid.Column="1"/>
            </Grid>
            <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,8,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Name="LabelTo"/><DatePicker Name="DatePickerTo" Grid.Column="1"/>
            </Grid>
            <Button Name="ButtonPairs" Grid.Row="2" Grid.Column="2" Margin="0,0,0,8"/>
            <Grid Grid.Row="3" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid Margin="0,0,8,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Label Name="LabelVolumeA"/><TextBox Name="TextBoxVolumeA" Grid.Row="1" Text="1"/></Grid>
                <Grid Grid.Column="1" Margin="0,0,8,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Label Name="LabelVolumeB"/><TextBox Name="TextBoxVolumeB" Grid.Row="1" Text="1"/></Grid>
                <Grid Grid.Column="2" Margin="0,0,8,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Label Name="LabelBarsA"/><TextBox Name="TextBoxBarsA" Grid.Row="1" Text="1"/></Grid>
                <Grid Grid.Column="3" Margin="0,0,8,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Label Name="LabelBarsB"/><TextBox Name="TextBoxBarsB" Grid.Row="1" Text="1"/></Grid>
                <Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Label Name="LabelCoverage"/><TextBox Name="TextBoxCoverage" Grid.Row="1" Text="80"/></Grid>
            </Grid>
        </Grid>
        <TextBlock Name="TextBlockWarning" Grid.Row="1" TextWrapping="Wrap" Margin="0,10" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Name="ButtonRun" MinWidth="150"/><Button Name="ButtonCancel" Grid.Column="1" MinWidth="100" Margin="8,0" IsEnabled="False"/>
            <TextBlock Name="TextBlockStatus" Grid.Column="2" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock Name="TextBlockSummary" Grid.Row="3" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TabControl Grid.Row="4">
            <TabItem Name="TabItemDays"><wfi:WindowsFormsHost Name="HostDays"/></TabItem>
            <TabItem Name="TabItemIntervals"><wfi:WindowsFormsHost Name="HostIntervals"/></TabItem>
            <TabItem Name="TabItemPoints"><wfi:WindowsFormsHost Name="HostPoints"/></TabItem>
        </TabControl>
        <TextBlock Name="TextBlockFooter" Grid.Row="5" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</Window>
