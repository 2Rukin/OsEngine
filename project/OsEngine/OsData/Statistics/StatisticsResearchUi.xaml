<Window x:Class="OsEngine.OsData.Statistics.StatisticsResearchUi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Width="1300" Height="900" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterOwner" Style="{StaticResource WindowStyleCanResize}" Icon="/Images/OsLogo.ico">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ControlForegroundWhite}"/></Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Name="TextBlockDescription" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TabControl Name="TabControlResults" Grid.Row="1">
            <TabItem Name="TabItemChart">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Name="ButtonPrevious" Content="←" Width="40"/>
                        <Button Name="ButtonNext" Content="→" Grid.Column="1" Width="40" Margin="4,0"/>
                        <Button Name="ButtonZoomIn" Content="+" Grid.Column="2" Width="40"/>
                        <Button Name="ButtonZoomOut" Content="−" Grid.Column="3" Width="40" Margin="4,0"/>
                        <Button Name="ButtonReset" Grid.Column="4" MinWidth="120"/>
                        <TextBlock Name="TextBlockChartHelp" Grid.Column="5" Margin="10,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                    <wfi:WindowsFormsHost Name="HostChart" Grid.Row="1"/>
                    <TextBlock Name="TextBlockCursor" Grid.Row="2" Margin="4" MinHeight="38" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
            <TabItem Name="TabItemStatistics">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
                    <wfi:WindowsFormsHost Name="HostSummary"/>
                    <TextBlock Name="TextBlockEpisodesDefinition" Grid.Row="1" TextWrapping="Wrap" Margin="4,8"/>
                    <wfi:WindowsFormsHost Name="HostEpisodeSummary" Grid.Row="2"/>
                </Grid>
            </TabItem>
            <TabItem Name="TabItemEpisodes"><wfi:WindowsFormsHost Name="HostEpisodes"/></TabItem>
            <TabItem Name="TabItemSamples"><wfi:WindowsFormsHost Name="HostSamples"/></TabItem>
        </TabControl>
        <TextBlock Name="TextBlockFooter" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </Grid>
</Window>
